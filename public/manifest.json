{
  "manifest_version": 3,
  "name": "looot: company and email lookup",
  "short_name": "looot",
  "version": "0.1.0",
  "description": "Search 2,500+ data APIs with prices. Enrich the company or find a work email for the site you are on. Pay per call.",
  "homepage_url": "https://looot.ai",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open looot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage", "activeTab"],
  "host_permissions": ["https://api.looot.ai/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.looot.ai"
  }
}
